#!/usr/bin/env bash
# Rivet launcher: pick a renderer that actually paints on this NVIDIA/Wayland box.
#
# Tiers (RIVET_RENDER_TIER=n forces one; QA uses that):
#   1  GTK and WebKit defaults (GTK's GL/Vulkan renderer, WebKit's DMA-BUF renderer)
#   2  GSK_RENDERER=cairo, WebKit DMA-BUF renderer still on
#   3  GSK_RENDERER=cairo + WEBKIT_DISABLE_DMABUF_RENDERER=1 (all-software, last resort)
#
# Why: GTK's GL renderer dies within a second ("Error 71 dispatching to Wayland display")
# whenever the NVIDIA userspace and kernel module versions differ, i.e. exactly the
# mid-upgrade window Rivet lives in, so a crash inside 4 s falls through to the next tier.
# Tier 3 used to be the default; with WebKitGTK 2.54 (2026-09-26) the non-DMA-BUF path
# stops painting most of the window once the page is taller than a few screens (only the
# rows the pointer touches get repainted). app/qa-render.sh is the regression check.
set -uo pipefail
here="$(dirname "$(readlink -f "$0")")"
tier=${RIVET_RENDER_TIER:-1}
while :; do
  case $tier in
    1) unset GSK_RENDERER WEBKIT_DISABLE_DMABUF_RENDERER ;;
    2) export GSK_RENDERER=cairo; unset WEBKIT_DISABLE_DMABUF_RENDERER ;;
    *) export GSK_RENDERER=cairo WEBKIT_DISABLE_DMABUF_RENDERER=1 ;;
  esac
  t0=$(date +%s)
  # run the app as a child (not exec) so a crash can fall through; forward TERM/INT to it
  # so killing the launcher never leaves a window behind
  python3 "$here/rivet_app.py" "$@" &
  child=$!
  trap 'kill -TERM $child 2>/dev/null' TERM INT HUP
  wait $child; rc=$?
  trap - TERM INT HUP
  if [[ -n "${RIVET_RENDER_TIER:-}" || $rc -eq 0 || $tier -ge 3 || $(( $(date +%s) - t0 )) -ge 4 ]]; then
    exit $rc
  fi
  echo "rivet-updater: renderer tier $tier exited $rc within 4 s, trying tier $((tier + 1))" >&2
  tier=$((tier + 1))
done
